@model List<FeedbackManagementMVC.Models.Feedback>
@{
    ViewData["Title"] = "Submitted Feedback";
}

<div class="page-heading">
    <h1>Submitted Feedback</h1>
    <p>Feedback submitted during the current application session.</p>
</div>

@if (Model.Count == 0)
{
    <div class="empty-message">No feedback submitted yet.</div>
}
else
{
    <div class="table-card">
        <table>
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Category</th>
                    <th>Rating</th>
                    <th>Feedback</th>
                    <th>Suggestions</th>
                    <th>Recommend</th>
                    <th>Date</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Name</td>
                        <td>@item.Email</td>
                        <td>@item.Category</td>
                        <td>@item.Rating / 5</td>
                        <td>@item.Message</td>
                        <td>@item.Suggestions</td>
                        <td>@item.Recommend</td>
                        <td>@item.SubmittedOn.ToString("dd-MM-yyyy HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
